    %% =========================================================================
    %%  Akademik+ - DFD poziomu 1 (diagram ogolny)
    %%  Notacja Yourdona (zgodnie z wykladem dr Tomasza Ordysinskiego)
    %%
    %%  Diagram zawiera 6 procesow (limit 3-7), wszystkie magazyny danych
    %%  z systemu oraz terminatory zewnetrzne. Kazdy magazyn jest uzywany
    %%  przez co najmniej dwa procesy (regula poprawnosci DFD).
    %%
    %%  Procesy odzwierciedlaja realna implementacje endpointow w
    %%  src/api/server.js. Magazyny D1-D5 to tabele MSSQL, D6-D9 to
    %%  kolekcje MongoDB.
    %% =========================================================================

    %% --- Terminatory ---
    Term_Student[Student]
    Term_Admin[Administrator]

    %% --- Magazyny danych (SQL Server) ---
    Store_Users[(D1: uzytkownicy)]
    Store_Rooms[(D2: pokoje)]
    Store_Students[(D3: studenci)]
    Store_Residence[(D4: historia zameldowan)]
    Store_Payments[(D5: oplaty)]

    %% --- Magazyny danych (MongoDB) ---
    Store_Conv[(D6: konwersacje)]
    Store_Messages[(D7: wiadomosci czatu)]
    Store_Issues[(D8: zgloszenia)]
    Store_IssueMsg[(D9: wiadomosci zgloszen)]

    %% --- Procesy ---
    P1((1. Uwierzytelnienie<br/>uzytkownika))
    P2((2. Rejestracja<br/>i ewidencja<br/>studentow))
    P3((3. Zarzadzanie<br/>pokojami<br/>i przydzialami))
    P4((4. Obsluga<br/>oplat<br/>miesiecznych))
    P5((5. Obsluga<br/>zgloszen<br/>usterek))
    P6((6. Wymiana<br/>wiadomosci<br/>czatu))

    %% --- Proces 1: Uwierzytelnienie ---
    Term_Student -- "dane logowania" --> P1
    Term_Admin -- "dane logowania" --> P1
    P1 -- "zapytanie o email" --> Store_Users
    Store_Users -- "profil i hasla" --> P1
    P1 -- "aktualizacja hasla" --> Store_Users
    P1 -- "ciasteczko sesji" --> Term_Student
    P1 -- "ciasteczko sesji" --> Term_Admin

    %% --- Proces 2: Rejestracja i ewidencja ---
    Term_Student -- "dane rejestracyjne" --> P2
    Term_Admin -- "edycja profilu studenta" --> P2
    P2 -- "wpis uzytkownika" --> Store_Users
    P2 -- "wpis studenta" --> Store_Students
    Store_Students -- "rejestr studentow" --> P2
    P2 -- "rejestr studentow" --> Term_Admin

    %% --- Proces 3: Pokoje i przydzialy ---
    Term_Admin -- "dane pokoju" --> P3
    Term_Admin -- "decyzja o przydziale" --> P3
    P3 -- "definicja pokoju" --> Store_Rooms
    Store_Rooms -- "stan pokoi" --> P3
    Store_Students -- "powiazanie z pokojem" --> P3
    P3 -- "aktualizacja zajetosci" --> Store_Rooms
    P3 -- "przypisanie do pokoju" --> Store_Students
    P3 -- "zapis zameldowania" --> Store_Residence
    Store_Residence -- "historia mieszkania" --> P3

    %% --- Proces 4: Oplaty ---
    Term_Admin -- "definicja oplaty" --> P4
    Term_Admin -- "potwierdzenie wplaty" --> P4
    Store_Students -- "powiazanie z oplata" --> P4
    Store_Rooms -- "cena za pokoj" --> P4
    P4 -- "wpis platnosci" --> Store_Payments
    Store_Payments -- "historia platnosci" --> P4
    P4 -- "harmonogram oplat" --> Term_Student
    P4 -- "raport finansowy" --> Term_Admin

    %% --- Proces 5: Zgloszenia usterek ---
    Term_Student -- "tresc zgloszenia" --> P5
    Term_Admin -- "zmiana statusu" --> P5
    P5 -- "wpis zgloszenia" --> Store_Issues
    Store_Issues -- "dane zgloszenia" --> P5
    P5 -- "tresc odpowiedzi" --> Store_IssueMsg
    Store_IssueMsg -- "historia wiadomosci" --> P5
    P5 -- "lista usterek" --> Term_Admin
    P5 -- "status zgloszenia" --> Term_Student

    %% --- Proces 6: Czat ---
    Term_Student -- "wiadomosc do administracji" --> P6
    Term_Admin -- "odpowiedz do studenta" --> P6
    P6 -- "metadane konwersacji" --> Store_Conv
    Store_Conv -- "lista konwersacji" --> P6
    P6 -- "tresc wiadomosci" --> Store_Messages
    Store_Messages -- "historia wiadomosci" --> P6
    P6 -- "odpowiedz administratora" --> Term_Student
    P6 -- "wiadomosc studenta" --> Term_Admin
